# Ambiente local sem Docker: backend serve o build completo em localhost:4205.
NODE_ENV=production
APP_PORT=4205
APP_HOST=127.0.0.1
APP_ORIGIN=http://localhost:4205
TZ=America/Sao_Paulo
TRUST_PROXY=false
COOKIE_SECURE=false
SESSION_DAYS=30
DATA_DIR=./data-local

# O primeiro boot cria somente Admin / Admin@123. Troque a senha no assistente
# e informe o segundo usuário antes de usar o aplicativo.
