# O Dockerfile define production no container; deixe ausente no desenvolvimento
# para o Vite não confundir NODE_ENV com o modo de build.
# Porta dentro do container; não altere para publicar outra porta.
APP_PORT=3000
# O processo precisa escutar na interface do container; a porta do host
# continua restrita por HOST_BIND abaixo.
APP_HOST=0.0.0.0
# Porta publicada no host pelo Compose.
HOST_PORT=4205
# Endereço de publicação; mantenha local até concluir o primeiro boot.
HOST_BIND=127.0.0.1
# Origem exata usada pelo navegador (usada na validação CSRF e CORS).
APP_ORIGIN=http://localhost:4205
TZ=America/Sao_Paulo
TRUST_PROXY=false
# true somente quando APP_ORIGIN usar HTTPS (Tailscale/reverse proxy).
COOKIE_SECURE=false
SESSION_DAYS=30

# Onde o SQLite fica (dentro do container é o volume persistente).
DATA_DIR=/app/data

# No primeiro boot existe apenas o usuário Admin, com a senha temporária
# Admin@123. O assistente autenticado pede as senhas definitivas.
