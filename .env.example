NODE_ENV=production
# Porta dentro do container; não altere para publicar outra porta.
APP_PORT=3000
# Porta publicada no host pelo Compose.
HOST_PORT=4205
# Origem exata usada pelo navegador (usada na validação CSRF e CORS).
APP_ORIGIN=http://localhost:4205
TZ=America/Sao_Paulo
TRUST_PROXY=false
# true somente quando APP_ORIGIN usar HTTPS (Tailscale/reverse proxy).
COOKIE_SECURE=false
SESSION_DAYS=30

# Onde o SQLite fica (dentro do container é o volume persistente).
DATA_DIR=/app/data

# Senhas iniciais — obrigatórias no primeiro boot, trocadas no primeiro login.
ALEXANDRE_INITIAL_PASSWORD=troque-por-uma-senha-real-com-12-ou-mais-caracteres
PRISCILA_INITIAL_PASSWORD=troque-por-uma-senha-real-com-12-ou-mais-caracteres
