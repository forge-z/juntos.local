    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/static": "10.1.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
